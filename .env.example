# Copy to .env (git-ignored) and adjust. Dev-only values: never use them outside local development.

# --- api-gateway ---------------------------------------------------------
NODE_ENV=development
API_GATEWAY_PORT=3000
# Comma-separated list of browser origins allowed by CORS (HTTP only)
CORS_ORIGINS=http://localhost:4200

# --- api-gateway WebSocket (same port as HTTP) ---------------------------
WS_PATH=/ws
# Origins allowed to open a WebSocket, checked on upgrade (CORS does not apply to WebSocket)
WS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4202
# Server ping interval in ms; a client missing one pong is terminated
WS_HEARTBEAT_MS=30000

# --- api-gateway databases (Prisma; one database per domain) -------------
# Must match POSTGRES_USER / POSTGRES_PASSWORD below. Tests use auth_test and
# chat_test on the same server (override with TEST_DATABASE_URL_AUTH/_CHAT).
DATABASE_URL_AUTH=postgresql://chat:change-me@localhost:5432/auth_db
DATABASE_URL_CHAT=postgresql://chat:change-me@localhost:5432/chat_db

# --- api-gateway auth ----------------------------------------------------
# HS256 signing key, at least 32 characters. Required when NODE_ENV=production;
# development falls back to a fixed insecure key. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
# A rotated refresh token presented again within this window gets a 401 but
# does not revoke the session (two tabs racing, lost response).
REFRESH_REUSE_GRACE_SECONDS=10
WS_TICKET_TTL_SECONDS=30
# true behind HTTPS: adds the Secure flag to the refresh-token cookie
COOKIE_SECURE=false

# --- RabbitMQ (docker compose) ------------------------------------------
RABBITMQ_USER=chat
RABBITMQ_PASSWORD=change-me
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
# Used by services from phase 3 on
RABBITMQ_URL=amqp://chat:change-me@localhost:5672

# --- PostgreSQL (docker compose) ----------------------------------------
POSTGRES_USER=chat
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# Extra databases created on first start (dev + test, one pair per domain).
# An existing volume keeps its databases: run `npm run db:test:ensure` instead.
POSTGRES_MULTIPLE_DATABASES=auth_db,chat_db,auth_test,chat_test

# --- Redis (docker compose) ---------------------------------------------
REDIS_PORT=6379
# Used by the api-gateway (WebSocket tickets). Tests use database 15 of the same
# server (override with TEST_REDIS_URL).
REDIS_URL=redis://localhost:6379
