# Copy to .env (git-ignored) and adjust. Dev-only values: never use them outside local development.
# Every app reads this one file but validates only the variables it uses
# (apps/<app>/src/config/env.schema.ts); the sections below say which app uses what.

# === Shared ===============================================================

# api-gateway, auth-service, chat-service
NODE_ENV=development
# RabbitMQ of the three apps (user/password: RABBITMQ_* below)
RABBITMQ_URL=amqp://chat:change-me@localhost:5672
# How long a caller waits for a service RPC (ms); requests expire after it
RPC_TIMEOUT_MS=5000
# HS256 key, at least 32 characters: auth-service signs access tokens with it,
# api-gateway verifies them with it (same value in both). Required when
# NODE_ENV=production; development falls back to a fixed insecure key.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# === api-gateway (HTTP + WebSocket edge, port 3000) =======================

API_GATEWAY_PORT=3000
# Comma-separated list of browser origins allowed by CORS (HTTP only, with
# credentials): the shell, and mfe-auth / mfe-chat when they run standalone
CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202
WS_PATH=/ws
# Origins allowed to open a WebSocket, checked on upgrade (CORS does not apply to WebSocket)
WS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4202
# Server ping interval in ms; a client missing one pong is terminated
WS_HEARTBEAT_MS=30000
# Sockets are closed (4000) after this long; clients reconnect with a new ticket
WS_MAX_AGE_SECONDS=900
# true behind HTTPS: adds the Secure flag to the refresh-token cookie
COOKIE_SECURE=false

# === auth-service (auth_db, Redis) =========================================

# Must match POSTGRES_USER / POSTGRES_PASSWORD below. Tests use auth_test on the
# same server (override with TEST_DATABASE_URL_AUTH).
DATABASE_URL_AUTH=postgresql://chat:change-me@localhost:5432/auth_db
# WebSocket tickets. Tests use database 15 of the same server (override with TEST_REDIS_URL).
REDIS_URL=redis://localhost:6379
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
# A rotated refresh token presented again within this window gets a 401 but
# does not revoke the session (two tabs racing, lost response).
REFRESH_REUSE_GRACE_SECONDS=10
WS_TICKET_TTL_SECONDS=30

# === chat-service (chat_db) ================================================

# Must match POSTGRES_USER / POSTGRES_PASSWORD below. Tests use chat_test
# (override with TEST_DATABASE_URL_CHAT).
DATABASE_URL_CHAT=postgresql://chat:change-me@localhost:5432/chat_db
# chat.send attempts before a failing command goes to chat.commands.dlq
CHAT_COMMAND_MAX_ATTEMPTS=3

# === docker compose ========================================================

RABBITMQ_USER=chat
RABBITMQ_PASSWORD=change-me
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
POSTGRES_USER=chat
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# Extra databases created on first start (dev + test, one pair per domain).
# An existing volume keeps its databases: run `npm run db:test:ensure` instead.
POSTGRES_MULTIPLE_DATABASES=auth_db,chat_db,auth_test,chat_test
REDIS_PORT=6379
