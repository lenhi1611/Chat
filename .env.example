# Copy to .env (git-ignored) and adjust. Dev-only values: never use them outside local development.

# --- api-gateway ---------------------------------------------------------
NODE_ENV=development
API_GATEWAY_PORT=3000
# Comma-separated list of browser origins allowed by CORS
CORS_ORIGINS=http://localhost:4200

# --- RabbitMQ (docker compose) ------------------------------------------
RABBITMQ_USER=chat
RABBITMQ_PASSWORD=change-me
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
# Used by services from phase 1 on
RABBITMQ_URL=amqp://chat:change-me@localhost:5672

# --- PostgreSQL (docker compose) ----------------------------------------
POSTGRES_USER=chat
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# Extra databases created on first start (one per service, phase 3)
POSTGRES_MULTIPLE_DATABASES=auth_db,chat_db

# --- Redis (docker compose) ---------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
